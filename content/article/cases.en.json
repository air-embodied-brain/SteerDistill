    {
      "id": "method",
      "case": {
        "kind": "training",
        "id": "tool-list-numbering",
        "title": "List numbers in tool names",
        "task": "The user asks to unlock all car doors and turn on the headlights. Items 16 and 20 in the tool list are lockDoors and setHeadlights; the numbers are not part of the names. Key calls and returned fields are excerpted below.",
        "href": "cases/?group=training&case=tool-list-numbering",
        "layout": "branches",
        "branches": [
          {
            "title": "No guidance",
            "tone": "before",
            "events": [
              {
                "type": "action",
                "name": "16_lockDoors",
                "args": "unlock=true, door=[\"driver\", \"passenger\", \"rear_left\", \"rear_right\"]",
                "result": "Unknown or unavailable advertised tool: 16_lockDoors",
                "highlights": {
                  "name": [
                    {
                      "start": 0,
                      "end": 3,
                      "text": "16_",
                      "tone": "before"
                    }
                  ]
                },
                "source": {
                  "file": "data/case-library/training/tool-list-numbering/raw/before/trajectory.json",
                  "message": 4,
                  "returnMessage": 5
                }
              },
              {
                "type": "action",
                "name": "20_setHeadlights",
                "args": "mode=\"on\"",
                "result": "Unknown or unavailable advertised tool: 20_setHeadlights",
                "highlights": {
                  "name": [
                    {
                      "start": 0,
                      "end": 3,
                      "text": "20_",
                      "tone": "before"
                    }
                  ]
                },
                "source": {
                  "file": "data/case-library/training/tool-list-numbering/raw/before/trajectory.json",
                  "message": 6,
                  "returnMessage": 7
                }
              }
            ]
          },
          {
            "title": "With teacher guidance",
            "tone": "after",
            "events": [
              {
                "type": "action",
                "name": "lockDoors",
                "args": "unlock=true, door=[\"driver\", \"passenger\", \"rear_left\", \"rear_right\"]",
                "result": "lockStatus: \"unlocked\", remainingUnlockedDoors: 4",
                "highlights": {
                  "name": [
                    {
                      "start": 0,
                      "end": 9,
                      "text": "lockDoors",
                      "tone": "after"
                    }
                  ],
                  "result": [
                    {
                      "start": 24,
                      "end": 49,
                      "text": "remainingUnlockedDoors: 4",
                      "tone": "after"
                    }
                  ]
                },
                "source": {
                  "file": "data/case-library/training/tool-list-numbering/raw/after/attempt-0/trajectory.json",
                  "message": 4,
                  "returnMessage": 5
                }
              },
              {
                "type": "action",
                "name": "setHeadlights",
                "args": "mode=\"on\"",
                "result": "headlightStatus: \"on\"",
                "highlights": {
                  "name": [
                    {
                      "start": 0,
                      "end": 13,
                      "text": "setHeadlights",
                      "tone": "after"
                    }
                  ],
                  "result": [
                    {
                      "start": 17,
                      "end": 21,
                      "text": "\"on\"",
                      "tone": "after"
                    }
                  ]
                },
                "source": {
                  "file": "data/case-library/training/tool-list-numbering/raw/after/attempt-0/trajectory.json",
                  "message": 6,
                  "returnMessage": 7
                }
              }
            ]
          }
        ],
        "guidance": {
          "summary": "Check the available unlocking and headlight tools; unlock all doors with lockDoors, then turn on the headlights with setHeadlights."
        },
        "checks": [
          {
            "label": "Local verification",
            "text": "All four doors are unlocked and the headlights are still off, matching the teacher reference at this turn. The check passes."
          },
          {
            "label": "Continuation",
            "text": "With the steering prompt removed, the agent calls `setHeadlights(mode=\"on\")` on its own; the doors stay unlocked and the task passes final verification."
          }
        ]
      }
    },
